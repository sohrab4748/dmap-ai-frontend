# DMAP-AI clean URL rules for Apache hosting
# Place this file in the website root.

DirectoryIndex index.html
RewriteEngine On

# --- Static asset caching (Apache equivalent of the Netlify _headers file) ---
# _headers is ignored by Apache, so long-lived caching must be set here.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|webp|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML should revalidate so content updates are picked up promptly.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
# --- end caching ---

# If a browser requests /index or /index.html, send it to the clean folder URL.
# THE_REQUEST prevents loops from internal rewrites.
RewriteCond %{THE_REQUEST} \s/+method-comparison/index(?:\.html)?[\s?] [NC]
RewriteRule ^method-comparison/index(?:\.html)?$ /method-comparison/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+method-comparison/(.+)/index(?:\.html)?[\s?] [NC]
RewriteRule ^method-comparison/(.+)/index(?:\.html)?$ /method-comparison/$1/ [R=301,L]

# Serve the landing page and station folders internally without changing the browser URL.
RewriteRule ^method-comparison/?$ method-comparison/index.html [L]
RewriteCond %{DOCUMENT_ROOT}/method-comparison/$1/index.html -f
RewriteRule ^method-comparison/([^/.]+)/?$ method-comparison/$1/index.html [L]
