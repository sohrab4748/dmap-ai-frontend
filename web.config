<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Keep method-comparison folder URLs clean.
             This prevents /method-comparison/phoenix-arizona/ from becoming /method-comparison/phoenix-arizona/index. -->

        <rule name="DMAP method comparison root index to folder" stopProcessing="true">
          <match url="^method-comparison/index(?:\.html)?$" ignoreCase="true" />
          <action type="Redirect" url="/method-comparison/" redirectType="Permanent" />
        </rule>

        <rule name="DMAP method comparison station index to folder" stopProcessing="true">
          <match url="^method-comparison/(.+)/index(?:\.html)?$" ignoreCase="true" />
          <action type="Redirect" url="/method-comparison/{R:1}/" redirectType="Permanent" />
        </rule>

        <rule name="DMAP serve method comparison root folder" stopProcessing="true">
          <match url="^method-comparison/?$" ignoreCase="true" />
          <action type="Rewrite" url="/method-comparison/index.html" />
        </rule>

        <rule name="DMAP serve method comparison station folders" stopProcessing="true">
          <match url="^method-comparison/([^/.]+)/?$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{DOCUMENT_ROOT}\method-comparison\{R:1}\index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/method-comparison/{R:1}/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
